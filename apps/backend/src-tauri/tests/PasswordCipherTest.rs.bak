use backend_lib::application::password::cipher::PasswordCipher;

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_encrypt_decrypt() {
        let passphrase = "mi_passphrase_segura";
        PasswordCipher::save_passphrase(passphrase);
        let password = "mi_contraseña_segura";

        let (encrypted, nonce) = PasswordCipher::encrypt(password).unwrap();
        let decrypted = PasswordCipher::decrypt(&encrypted, &nonce).unwrap();

        assert_eq!(password, decrypted);
    }
}