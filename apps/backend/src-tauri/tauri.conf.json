{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Termo",
  "version": "1.0.0",
  "identifier": "com.termo.terminal",
  "build": {
    "beforeBuildCommand": "pnpm --filter frontend run build",
    "beforeDevCommand": "pnpm --filter frontend run dev",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Termo",
        "width": 1000,
        "height": 500,
        "titleBarStyle": "Overlay",
        "theme": "Dark",
        "decorations": true,
        "shadow": true,
        "backgroundColor": "#1a1a1a"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "bin/plink.exe"
    ],
    "windows": {
      "wix": {
        "language": ["en-US"]
      }
    }
  }
}
